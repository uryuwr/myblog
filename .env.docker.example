# Docker 环境变量配置模板
# 
# ⚠️  使用方法：
# 1. 复制此文件为 .env.docker
#    cp .env.docker.example .env.docker
#
# 2. 编辑 .env.docker 填入你的真实配置
#
# ⚠️  安全提示：
# - .env.docker 已在 .gitignore 中，不会被提交到 Git
# - 切勿将真实密钥提交到版本控制！
#

# ============ 邮件 SMTP 配置 ============
# QQ 邮箱设置方法：
# 1. 登录 QQ 邮箱 -> 设置 -> 账户 -> POP3/SMTP服务 -> 开启
# 2. 获取授权码（不是 QQ 密码！）

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code
EMAIL_FROM="MyBlog Terminal" <your-email@qq.com>

# ============ 安全配置 ============
# JWT 密钥（请使用随机字符串，推荐 32+ 字符）
# 生成方法：openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-string

# 允许登录的邮箱白名单（多个用逗号分隔，留空允许所有）
ALLOWED_EMAILS=

# ============ 可选配置 ============
# 是否自动启动 Claude（Docker 环境默认关闭，因为容器内没有 claude）
# AUTO_START_CLAUDE=false

# 语音转文字服务（如果不用可以不配置）
# WHISPER_URL=http://localhost:5000/transcribe
