# 邮件 SMTP 配置
# 以 QQ 邮箱为例：
# 1. 登录 QQ 邮箱 -> 设置 -> 账户 -> POP3/SMTP服务 -> 开启
# 2. 获取授权码（不是QQ密码）

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code

# 发件人显示名称
EMAIL_FROM="MyBlog Terminal" <your-email@qq.com>

# JWT 密钥（生产环境请使用复杂的随机字符串）
JWT_SECRET=your-super-secret-key-change-in-production

# 允许登录的邮箱白名单（多个邮箱用逗号分隔，留空表示允许所有邮箱）
ALLOWED_EMAILS=admin@example.com,user@example.com

# 注意：
# - 如果不配置邮件，验证码会在控制台打印（开发模式）
# - 生产环境强烈建议配置真实的 SMTP 服务
