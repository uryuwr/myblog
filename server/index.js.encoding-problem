// 将音频转换为 MP3 格式（GLM 支持的格式）
async function convertAudioToMp3(inputBuffer, inputMimeType) {
  return new Promise((resolve, reject) => {
    const tempId = randomUUID();
    const tempDir = tmpdir();
    
    // 确定输入文件扩展名
    let inputExt = '.webm';
    if (inputMimeType.includes('mp4')) inputExt = '.mp4';
    else if (inputMimeType.includes('wav')) inputExt = '.wav';
    else if (inputMimeType.includes('ogg')) inputExt = '.ogg';
    else if (inputMimeType.includes('aac')) inputExt = '.aac';
    
    const inputPath = join(tempDir, `input_${tempId}${inputExt}`);
    const outputPath = join(tempDir, `output_${tempId}.mp3`);
    
    // 写入临时输入文件
    writeFileSync(inputPath, inputBuffer);
    
    // 转换为 MP3
    ffmpeg(inputPath)
      .audioCodec('libmp3lame')
      .audioChannels(1)
      .audioFrequency(16000)
      .audioBitrate('64k')
      .format('mp3')
      .on('end', () => {
        try {
          const outputBuffer = readFileSync(outputPath);
          // 清理临时文件
          try { unlinkSync(inputPath); } catch {}
          try { unlinkSync(outputPath); } catch {}
          resolve(outputBuffer);
        } catch (err) {
          reject(err);
        }
      })
      .on('error', (err) => {
        // 清理临时文件
        try { unlinkSync(inputPath); } catch {}
        try { unlinkSync(outputPath); } catch {}
        reject(err);
      })
      .save(outputPath);
  });
}

// 语音转文字 API（优先使用本地 Whisper，备用 GLM API）
app.post('/api/speech-to-text', upload.single('file'), async (req, res) => {
  // 验证用户已登录
  const authHeader = req.headers.authorization;
  if (!authHeader || !authHeader.startsWith('Bearer ')) {
    return res.status(401).json({ error: '未授权' });
  }

  const token = authHeader.split(' ')[1];
  const decoded = verifyToken(token);
  if (!decoded) {
    return res.status(401).json({ error: 'Token 无效' });
  }

  if (!req.file) {
    return res.status(400).json({ error: '未上传音频文件' });
  }

  const mimeType = req.file.mimetype || 'audio/webm';
  console.log(`🎤 语音识别请求 - 文件大小: ${req.file.buffer.length} bytes, 类型: ${mimeType}`);

  // 使用本地 Whisper 服务
  try {
    console.log(`🔄 尝试本地 Whisper 服务: ${WHISPER_URL}`);

    // 保存临时文件，然后发送给 Whisper
    const tempDir = tmpdir();
    const tempId = Date.now();
    const inputExt = mimeType === 'audio/webm' ? '.webm' : '.mp3';
    const inputPath = join(tempDir, `input_${tempId}${inputExt}`);

    // 写入临时音频文件
    writeFileSync(inputPath, req.file.buffer);

    const formData = new FormData();
    formData.append('file', createReadStream(inputPath));

    const whisperResponse = await axios.post(WHISPER_URL, formData, {
      headers: formData.getHeaders(),
      timeout: 60000
    });

    // 清理临时文件
    try { unlinkSync(inputPath); } catch {}
    try { unlinkSync(outputPath); } catch {}

    if (whisperResponse.data.success && whisperResponse.data.text) {
      console.log(`✅ Whisper 识别成功: ${whisperResponse.data.text}`);
      return res.json({
        success: true,
        text: whisperResponse.data.text,
        provider: 'whisper'
      });
    }
  } catch (whisperError) {
    console.log(`⚠️ Whisper 服务不可用: ${whisperError.message}`);
  }

// 健康检查
app.get('/api/health', (req, res) => {
  res.json({ status: 'ok', websocket: true, pty: true });
});

// 获取本机局域网 IP
function getLocalIP() {
  const nets = networkInterfaces();
  for (const name of Object.keys(nets)) {
    for (const net of nets[name]) {
      if (net.family === 'IPv4' && !net.internal) {
        return net.address;
      }
    }
  }
  return 'localhost';
}

// 启动服务器 - 监听所有网络接口
server.listen(PORT, '0.0.0.0', () => {
  const localIP = getLocalIP();
  console.log(`🚀 Terminal Server running at http://localhost:${PORT}`);
  console.log(`🌐 局域网访问: http://${localIP}:${PORT}`);
  console.log(`🔌 WebSocket endpoint: ws://${localIP}:${PORT}`);
  console.log(`📟 使用 node-pty 提供完整 PTY 支持`);
  console.log(`📁 Working directory: ${process.cwd()}`);
});
